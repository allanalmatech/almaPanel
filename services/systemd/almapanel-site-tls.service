[Unit]
Description=Renew almaPanel-managed website certificates
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/almapanel/installer/renew-site-tls.sh
UMask=0077
PrivateTmp=true
TimeoutStartSec=1200
