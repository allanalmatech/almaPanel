[Unit]
Description=almaPanel worker — Alma Tech Labs Inc.
After=almapanel-agent.service
Requires=almapanel-agent.service
[Service]
User=almapanel
Group=almapanel
WorkingDirectory=/opt/almapanel
EnvironmentFile=/etc/almapanel/panel.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m worker.main
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/almapanel
InaccessiblePaths=/srv/almapanel /etc/almapanel /var/lib/almapanel-agent
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
